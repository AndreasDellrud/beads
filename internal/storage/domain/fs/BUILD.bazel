load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "fs",
    srcs = [
        "beads.go",
        "context.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/storage/domain/fs",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/config",
        "//internal/configfile",
        "//internal/doltserver",
        "//internal/gitignore",
        "//internal/storage/domain",
        "//internal/utils",
    ],
)

go_test(
    name = "fs_test",
    srcs = [
        "beads_test.go",
        "context_test.go",
        "suite_test.go",
    ],
    embed = [":fs"],
    deps = [
        "//internal/beads",
        "//internal/config",
        "//internal/configfile",
        "//internal/git",
        "//internal/storage/backendnames",
        "//internal/storage/domain",
        "//internal/utils",
        "@com_github_stretchr_testify//require",
        "@com_github_stretchr_testify//suite",
    ],
)

# fs_test without -short, as pr.yml's "Test (storage domain + uow)" job runs
# its package (--config=ci passes -test.short). It needs no Dolt server; it is
# in the dolt-server lane so that lane alone runs every package of the job.
# GOMAXPROCS=4 is the job's runner shape.
#
# Tags:
#   dolt-server: part of the dolt-server lane (--config=doltserver), which
#     runs the whole job without -short; excluded from --config=prcore/ci.
sh_test(
    name = "fs_noshort_test",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :fs_test)"],
    data = [":fs_test"],
    env = {"GOMAXPROCS": "4"},
    tags = ["dolt-server"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---
